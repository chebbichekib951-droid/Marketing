        "jsCode": "const responseText = $json.content[0].text;\nconst parsed = JSON.parse(responseText);\nconst fullContent = `${parsed.intro}\\n\\n${parsed.content}\\n\\n${parsed.conclusion}`;\nreturn [{\n  json: {\n    title: parsed.title,\n    meta_description: parsed.meta_description,\n    slug: parsed.slug,\n    content: fullContent,\n    focus_keyword: parsed.focus_keyword,\n    tags: parsed.tags,\n    status: 'draft'\n  }\n}];"
      },
