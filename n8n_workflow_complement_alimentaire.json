        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-opus-4-6\",\n  \"max_tokens\": 1500,\n  \"messages\": [{\n    \"role\": \"user\",\n    \"content\": \"Tu es un expert TikTok spécialisé en compléments alimentaires. Crée un script vidéo TikTok viral de 30-60 secondes pour : {{ $json['Nom du produit ou sujet'] }}. Ton : {{ $json['Ton de communication'] }}. Infos : {{ $json['Informations supplémentaires'] }}. Réponds UNIQUEMENT en JSON valide : {\\\"hook\\\": \\\"Accroche percutante des 3 premières secondes\\\", \\\"script\\\": \\\"Script complet avec indications [PAUSE] [ZOOM IN] [TEXT ON SCREEN: xxx]\\\", \\\"cta\\\": \\\"Appel à l'action final\\\", \\\"hashtags\\\": [\\\"#hashtag1\\\", \\\"#hashtag2\\\"], \\\"thumbnail_prompt\\\": \\\"Detailed English description for DALL-E thumbnail: energetic person with supplement product, bold colors, action shot\\\"}\"\n  }]\n}"
