            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-opus-4-6\",\n  \"max_tokens\": 1024,\n  \"messages\": [{\n    \"role\": \"user\",\n    \"content\": \"Tu es un expert en marketing digital pour les compléments alimentaires. Crée un post Instagram engageant pour le produit/sujet suivant : {{ $json['Nom du produit ou sujet'] }}. Ton souhaité : {{ $json['Ton de communication'] }}. Infos supplémentaires : {{ $json['Informations supplémentaires'] }}. Réponds UNIQUEMENT en JSON valide avec cette structure exacte : {\\\"caption\\\": \\\"Texte du post max 2200 caractères avec emojis\\\", \\\"hashtags\\\": [\\\"#hashtag1\\\", \\\"#hashtag2\\\"], \\\"image_prompt\\\": \\\"Detailed English description for DALL-E: professional product photography of supplement, bright studio lighting, minimalist white background, premium branding\\\"}\"\n  }]\n}"
      },
      "id": "claude-instagram-caption-003",
      "name": "Claude - Caption Instagram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 160]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const responseText = $json.content[0].text;\nconst parsed = JSON.parse(responseText);\nconst formData = $('Formulaire de Création').first().json;\nreturn [{\n  json: {\n    caption: parsed.caption,\n    hashtags: parsed.hashtags.join(' '),\n    image_prompt: parsed.image_prompt,\n    full_caption: parsed.caption + '\\n\\n' + parsed.hashtags.join(' '),\n    produit: formData['Nom du produit ou sujet']\n  }\n}];"
      },
      "id": "parse-instagram-004",
      "name": "Parser - Caption IG",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [940, 160]
    },
